# 服务端口（个人版本地运行，默认 3003，与 mobile 端默认地址对齐）
PORT=3003

# JWT 认证
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# AI 模型（MiMo / OpenAI 兼容 Chat Completions API）
MIMO_API_KEY=sk-your-api-key-here
MIMO_API_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5

# 邮件服务（Resend，可选；未配置时验证码打印到后端控制台）
RESEND_API_KEY=re-your-api-key-here
MAIL_FROM=KB教练 <noreply@kbcoach.app>

# CORS 允许的来源（逗号分隔，留空则使用本机调试默认值）
# CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:3003
